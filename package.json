{
  "name": "sable-workspace",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "b4:install": "pnpm --dir vendor/b4 install --frozen-lockfile --filter @b4/react...",
    "b4:build": "pnpm --dir vendor/b4 --filter @b4/tokens --filter @b4/motion --filter @b4/react run build",
    "b4:link": "node scripts/link-b4.mjs",
    "dev": "pnpm --filter @sable/app tauri dev",
    "build": "pnpm --filter @sable/app build && pnpm --filter @sable/app tauri build",
    "typecheck": "pnpm --filter @sable/app typecheck",
    "test": "pnpm --filter @sable/app test",
    "check": "pnpm typecheck && pnpm test && cargo test --manifest-path apps/sable/src-tauri/Cargo.toml"
  }
}
