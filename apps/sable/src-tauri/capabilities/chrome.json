{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chrome-capability",
  "description": "Privileged browser chrome and the command-palette overlay. Page webviews are not listed, so navigated websites cannot call these commands.",
  "webviews": ["chrome", "overlay"],
  "permissions": [
    "core:event:default",
    "allow-session-snapshot",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-new-tab",
    "allow-close-tab",
    "allow-select-tab",
    "allow-pin-tab",
    "allow-move-tab",
    "allow-set-layout",
    "allow-set-theme",
    "allow-select-space",
    "allow-new-space",
    "allow-toggle-split",
    "allow-set-split-ratio",
    "allow-focus-pane",
    "allow-open-palette",
    "allow-close-palette",
    "allow-probe"
  ]
}
